        let policy = PcrPolicy {
            expected_pcrs: vec![pcr(0, vec![1; 32])],
        };
        let submitted = vec![pcr(0, vec![0xFF; 32])];
        assert!(matches!(
            verify_pcr_policy(&submitted, &policy),
            Err(AttestError::PolicyMismatch)
        ));
    }

