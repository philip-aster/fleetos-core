syntax = "proto3";
package fleetos;

import "workload.proto";
import "state.proto"; // CR-2: reuse SagRule/PeerSelector — never redefine.
import "provisioning.proto"; // CR-12: reuse NodeKind — never redefine.

service AdminService {
  // --- Existing surface (unchanged) ---
  rpc CreateTenant(CreateTenantRequest) returns (CreateTenantResponse);
  rpc SubmitWorkloadSpec(WorkloadSpec) returns (WorkloadSpecAck);
  rpc ListNodes(ListNodesRequest) returns (ListNodesResponse);
  rpc GetClusterStatus(GetClusterStatusRequest) returns (ClusterStatus);
  rpc GenerateJoinToken(GenerateJoinTokenRequest) returns (GenerateJoinTokenResponse);
  rpc SubmitCronWorkload(CronWorkload) returns (CronWorkloadAck);

  // --- CR-2: SAG administration ---
  rpc UpsertSagRule(UpsertSagRuleRequest) returns (SagRuleAck);
  rpc DeleteSagRule(DeleteSagRuleRequest) returns (SagRuleAck);

  // --- CR-2: secret store ---
  rpc StoreSecret(StoreSecretRequest) returns (SecretAck);
  rpc GrantSecretAccess(SecretAclChange) returns (SecretAck);
  rpc RevokeSecretAccess(SecretAclChange) returns (SecretAck);

  // --- CR-2: degraded-mode delegated signing ---
  rpc RequestDelegatedKey(DelegatedKeyRequest) returns (DelegatedKeyResponse);

  // --- CR-2: workload lifecycle ---
  rpc DeleteWorkload(DeleteWorkloadRequest) returns (WorkloadSpecAck);
  rpc ScaleWorkload(ScaleWorkloadRequest) returns (WorkloadSpecAck);

  // --- CR-2: node administration ---
  rpc CordonNode(NodeId) returns (NodeAck);
  rpc EvictNode(NodeId) returns (NodeAck); // admin-initiated; distinct from lease eviction

  // --- CR-12: node pool management (V-3 remediation — Raft entry point) ---
  rpc CreateNodePool(NodePoolCreateRequest) returns (NodePoolAck);
  rpc DeleteNodePool(NodePoolDeleteRequest) returns (NodePoolAck);
  rpc ListNodePools(ListNodePoolsRequest) returns (ListNodePoolsResponse);

  // --- CR-10: EK registration for secure attestation ---
  rpc RegisterNodeEk(RegisterNodeEkRequest) returns (RegisterNodeEkResponse);
  rpc RevokeNodeEk(RevokeNodeEkRequest) returns (NodeAck);

  // --- CR-14: PCR policy registration (secure attestation software state) ---
  // The state machine already applies FleetosCommand::SetPcrPolicy, but had no
  // RPC to propose it — so PCR policies could never be registered and quote
  // verification could never enforce software state. This closes that gap.
  rpc SetPcrPolicy(SetPcrPolicyRequest) returns (PcrPolicyAck);

  // --- CR-2 / CR-7: tenant quotas ---
  rpc SetQuota(QuotaRequest) returns (QuotaAck);
  rpc GetQuota(QuotaRequest) returns (QuotaResponse);

  // --- CR-8: Operator JIT access ---
  rpc GrantOperatorAccess(GrantOperatorAccessRequest) returns (OperatorAccessAck);
  rpc RevokeOperatorAccess(RevokeOperatorAccessRequest) returns (OperatorAccessAck);
  rpc ListOperatorAccess(ListOperatorAccessRequest) returns (ListOperatorAccessResponse);

  // --- CR-9: replicated audit log ---
  rpc ListAuditLog(ListAuditLogRequest) returns (ListAuditLogResponse);
}

message CreateTenantRequest {
  string tenant_id = 1;
}

message CreateTenantResponse {
  bool success = 1;
}

message WorkloadSpecAck {
  bool accepted = 1;
}

message ListNodesRequest {}

message ListNodesResponse {
  repeated string node_svids = 1;
}

message GetClusterStatusRequest {}

message ClusterStatus {
  uint64 raft_term = 1;
  uint32 healthy_nodes = 2;
}

message GenerateJoinTokenRequest {
  string node_kind = 1; // e.g., "agent", "router", "gateway", "control"
}

message GenerateJoinTokenResponse {
  bytes token = 1; // 32-byte cryptographically random token
}

message CronWorkloadAck {
  bool accepted = 1;
}

// ================= CR-2: SAG administration =================

message UpsertSagRuleRequest {
  // Rule to insert or replace. The canonical rule id is recomputed
  // server-side from rule content (SagRuleId::of_rule); any caller-supplied
  // id is advisory.
  SagRule rule = 1;
}

message DeleteSagRuleRequest {
  string rule_id = 1; // canonical id as returned by UpsertSagRule
}

message SagRuleAck {
  bool accepted = 1;
  string rule_id = 2; // canonical deterministic id of the affected rule
}

// ================= CR-2: secret store =================

message StoreSecretRequest {
  string tenant_id = 1; // scoping for management/listing; see addendum note
  string key = 2;
  bytes value = 3;
  repeated string authorized_spiffe_ids = 4;
}

message SecretAck {
  bool accepted = 1;
}

message SecretAclChange {
  string tenant_id = 1;
  string key = 2;
  string spiffe_id = 3;
}

// ================= CR-2: delegated signing =================

message DelegatedKeyRequest {
  string node_svid = 1;
  string target_spiffe_id = 2;
  optional uint32 target_ordinal = 3; // absent = role-level renewal scope
  uint64 requested_ttl_secs = 4;      // upper bound; control may grant less
}

message DelegatedKeyResponse {
  bytes delegation_id = 1;  // 16-byte DelegationId
  bytes key_material = 2;   // opaque; control's postcard shadow-struct format
  uint64 expires_at_unix = 3;
}

// ================= CR-2: workload lifecycle =================

message DeleteWorkloadRequest {
  string tenant_id = 1;
  string workload_id = 2;
}

message ScaleWorkloadRequest {
  string tenant_id = 1;
  string workload_id = 2;
  map<string, uint32> replicas = 3; // per-role desired counts; same shape as WorkloadSpec.replicas
}

// ================= CR-2: node administration =================

message NodeId {
  string node_svid = 1;
}

message NodeAck {
  bool accepted = 1;
}

// ================= CR-12: node pool management =================
// V-3 remediation: pool lifecycle enters through these RPCs so control
// proposes StoreNodePool/DeleteNodePool through Raft instead of writing
// fjall directly. Pool state becomes replicated and survives failover.

message NodePoolCreateRequest {
  // Operator-assigned primary key; the state machine keys on this.
  string pool_id = 1;
  // Imported from provisioning.proto — never redefine.
  NodeKind node_kind = 2;
  uint32 desired_count = 3;
  // Flat resource fields deliberately mirror control's NodePoolRecord
  // (the Raft payload). Do not collapse into provisioning.ResourceSpec.
  uint32 vcpus = 4;
  uint32 memory_mb = 5;
  uint32 disk_gb = 6;
  string region_hint = 7;
  // No bootstrap_payload: the ProvisioningReconciler constructs it at
  // reconciliation time with a fresh join token — never stored replicated.
}

message NodePoolDeleteRequest {
  string pool_id = 1;
}

message NodePoolAck {
  bool accepted = 1;
}

message ListNodePoolsRequest {}

message NodePoolInfo {
  // Mirrors control's NodePoolRecord for the list response.
  string pool_id = 1;
  NodeKind node_kind = 2;
  uint32 desired_count = 3;
  uint32 vcpus = 4;
  uint32 memory_mb = 5;
  uint32 disk_gb = 6;
  string region_hint = 7;
}

message ListNodePoolsResponse {
  repeated NodePoolInfo pools = 1;
}

// ================= CR-10: EK registration for secure attestation =================

message RegisterNodeEkRequest {
  // EK certificate (DER). Preferred: enables manufacturer chain validation.
  bytes ek_cert_der = 1;
  // EK public key. Fallback when no certificate is available. Canonical
  // form: SubjectPublicKeyInfo DER (RFC 5280 §4.1.2.7) — the exact bytes
  // embedded in the EK certificate's TBS. When the certificate is
  // available, control MUST fingerprint via EkFingerprint::of_ek_cert;
  // of_ek_pub applies only when SPKI is already extracted.
  bytes ek_pub = 2;
  // Optional: pre-bind to a node SPIFFE ID.
  string node_id = 3;
  // TTL for the registration (seconds). 0 = use configured default.
  uint64 ttl_secs = 4;
}

message RegisterNodeEkResponse {
  bool accepted = 1;
  // Canonical fingerprint of the registered EK public key, lowercase-hex
  // wire form. Recomputed via EkFingerprint::of_ek_pub — fleetos-core owns
  // this hashing convention; local re-implementations are prohibited.
  string ek_fingerprint = 2;
}

message RevokeNodeEkRequest {
  // Canonical fingerprint as returned by RegisterNodeEk.
  string ek_fingerprint = 1;
}

// ================= CR-14: PCR policy registration =================
message SetPcrPolicyRequest {
  // Node SPIFFE ID the policy applies to.
  string node_id = 1;
  // Expected PCR register values (canonical model, mirrors core PcrValue).
  repeated PcrValueProto expected_pcrs = 2;
  // Whether this policy is currently enforced for the node.
  bool active = 3;
}
message PcrValueProto {
  uint32 index = 1;           // PCR index 0-23
  uint32 hash_algorithm = 2;  // TPMI_ALG_HASH (SHA-256 = 0x000B)
  bytes digest = 3;
}
message PcrPolicyAck {
  bool accepted = 1;
}

// ================= CR-7: tenant quotas =================

message TenantQuota {
  string tenant_id = 1;
  uint64 max_cpu_millicores = 2;
  uint64 max_memory_bytes = 3;
  uint32 max_workloads = 4;
}

message QuotaRequest {
  // SetQuota: the full quota is applied. GetQuota: only quota.tenant_id is read.
  TenantQuota quota = 1;
}

message QuotaAck {
  bool accepted = 1;
}

message QuotaResponse {
  TenantQuota quota = 1;
}

// ================= CR-8: Operator JIT access =================

// Authorization scope for an operator grant.
message OperatorScope {
  // Full cluster-level admin access (node cordon/evict, SAG rules, tenants,
  // operator management). Implies access to all tenants.
  bool cluster_admin = 1;
  // Tenants this operator may operate on for tenant-scoped actions
  // (submit/scale/delete workloads, secrets). Empty = no tenant access
  // unless cluster_admin is true.
  repeated string tenants = 2;
  // CR-8 amendment: read-only operators may perform read operations
  // (List*/Get*) but not mutating operations. Orthogonal to cluster_admin
  // and tenants — cluster_admin=true + read_only=true yields a read-only
  // cluster admin.
  bool read_only = 3;
}

message GrantOperatorAccessRequest {
  // SPIFFE ID of the attested operator
  // (spiffe://<admin-td>/ns/system/operator/<name>).
  string operator_id = 1;
  // Upper bound; control may grant less. 0 = use configured default.
  uint64 ttl_secs = 2;
  OperatorScope scope = 3;
}

message RevokeOperatorAccessRequest {
  // Canonical id as returned by GrantOperatorAccess. Recomputed server-side
  // via OperatorGrantId::of_grant — callers cannot forge ids.
  string grant_id = 1;
}

message ListOperatorAccessRequest {}

message OperatorAccessGrant {
  string grant_id = 1;         // canonical; see OperatorGrantId::of_grant
  string operator_id = 2;
  string granted_by = 3;       // operator/admin who issued it
  uint64 granted_at_unix = 4;  // leader-computed before proposal
  uint64 expires_at_unix = 5;  // leader-computed before proposal
  OperatorScope scope = 6;
}

message ListOperatorAccessResponse {
  repeated OperatorAccessGrant grants = 1;
}

message OperatorAccessAck {
  bool accepted = 1;
  string grant_id = 2; // empty when accepted == false
}

// ================= CR-9: replicated audit log =================

message ListAuditLogRequest {
  // inclusive lower bound, 0 = start
  uint64 from_version = 1;
  // 0 = default cap (e.g. 1000)
  uint64 max_entries = 2;
}

message AuditEntry {
  uint64 version = 1;
  string request_id = 2;
  string actor = 3;
  string action = 4;
  string target = 5;
  uint64 timestamp_unix = 6;
}

message ListAuditLogResponse {
  repeated AuditEntry entries = 1;
}
</file>

