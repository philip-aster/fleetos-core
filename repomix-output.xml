<file path="proto/identity.proto">
syntax = "proto3";
package fleetos;

// The Attestation Service handles verifying hardware quotes and join tokens.
service AttestationService {
  // --- Insecure mode (testing): join-token flow, unchanged ---
  rpc RequestNonce(NonceRequest) returns (NonceResponse);
  rpc SubmitQuote(AttestationQuote) returns (AttestedIdentity);

  // --- CR-10 secure mode (production): TPM 2.0 credential activation ---
  // EK-rooted; no join token. RequestActivation issues the
  // TPM2_MakeCredential challenge; SubmitActivationProof verifies the
  // HMAC proof + PCR quote, signs the embedded CSR, and returns the
  // issued node SVID in one step.
  rpc RequestActivation(ActivationRequest) returns (ActivationChallenge);
  rpc SubmitActivationProof(ActivationProof) returns (SvidResponse);
}

// The CA Service handles signing CSRs once attestation is verified.
service CaService {
  // CR-6 CONTRACT: post-join, SubmitCsr is RENEWAL-ONLY. The caller's mTLS
  // SVID must either match the CSR's SPIFFE ID, or be the hosting node with
  // a verified placement for the target workload. Initial issuance requires
  // prior attestation via AttestationService. Control enforces this
  // (Master finding M-3); agents build against this rule.
  rpc SubmitCsr(CsrRequest) returns (SvidResponse);
  rpc GetTrustBundle(TrustBundleRequest) returns (TrustBundle);
}

message NonceRequest {
  string claimed_spiffe_id = 1;
}

message NonceResponse {
  bytes nonce = 1;
}

// Moved QuoteType to the top level so both messages can use it cleanly.
// CR-10 decision 5: APPLE_SE is retained but NOT used for cluster
// attestation (reserved for operator use). Removal would be breaking.
enum QuoteType {
  TPM2 = 0;
  APPLE_SE = 1;
  VSOCK = 2;
}

message AttestationQuote {
  QuoteType quote_type = 1;
  bytes raw_quote = 2;
  bytes raw_signature = 3;
  string join_token = 4;
  // CR-1: node's X25519 sealing pubkey (MUST be exactly 32 bytes).
  // Generated by the node pre-attestation; control stores it at SubmitQuote
  // time keyed by the attested SPIFFE ID. This is the sealing target for
  // SecretService.FetchSecret.
  //
  // SECURITY: claimed field — NOT covered by the hardware quote signature.
  // Binding to the attested identity is only as strong as quote verification
  // itself. Secret delivery MUST NOT be enabled in production until control's
  // tpm/apple_se signature verification is implemented.
  bytes agent_x25519_pubkey = 5;
}

message AttestedIdentity {
  string claimed_spiffe_id = 1;
  QuoteType quote_type = 2;
  bytes pcr_digest = 3;
  int64 verified_at_unix = 4;
}

message CsrRequest {
  bytes csr_der = 1;
}

message SvidResponse {
  bytes cert_chain_der = 1;
  // Insecure mode: may carry control-generated key material.
  // CR-10 secure mode: EMPTY — the node holds its own private key; only
  // the signed certificate chain is returned.
  bytes keypair_der = 2;
  uint64 svid_version = 3;
}

message TrustBundleRequest {}

message TrustBundle {
  string trust_domain = 1;
  repeated bytes roots_der = 2;
}

// ================= CR-10: secure attestation — TPM credential activation =================

// Node -> Control: present ephemeral AK + EK to begin credential activation.
message ActivationRequest {
  // Ephemeral Attestation Key public key (TPMT_PUBLIC, marshaled).
  bytes ak_pub = 1;
  // EK certificate (DER). Preferred: enables manufacturer chain validation.
  bytes ek_cert_der = 2;
  // EK public key. Fallback when no certificate is available. Canonical
  // form: SubjectPublicKeyInfo DER (RFC 5280 §4.1.2.7) — the exact bytes
  // embedded in the EK certificate's TBS. When the certificate is
  // available, control MUST fingerprint via EkFingerprint::of_ek_cert;
  // of_ek_pub applies only when SPKI is already extracted. One EK yields
  // one fingerprint regardless of presentation form.
  bytes ek_pub = 3;
}

// Control -> Node: TPM2_MakeCredential challenge.
message ActivationChallenge {
  // credentialBlob output of TPM2_MakeCredential (TPM2B_ID_OBJECT).
  bytes credential_blob = 1;
  // secret output of TPM2_MakeCredential (TPM2B_ENCRYPTED_SECRET).
  bytes secret = 2;
  // Server-generated nonce; the node binds it into the HMAC proof.
  bytes server_nonce = 3;
}

// Node -> Control: proof the credential was activated + attestation evidence + CSR.
message ActivationProof {
  // HMAC(key = S, payload = server_nonce). Proves S was unsealed by the TPM.
  bytes hmac = 1;
  // TPM quote (TPMS_ATTEST) with PCR selection (software-state attestation).
  bytes quote = 2;
  // AK signature over the quote.
  bytes quote_signature = 3;
  // Serialized PCR selection/values included in the quote.
  bytes pcr_selection = 4;
  // CSR for the node SVID (submitted after HMAC proof; decision 4).
  bytes csr_der = 5;
  // CR-14 / S-10: node's X25519 sealing pubkey (MUST be exactly 32 bytes).
  // Secure-flow counterpart of AttestationQuote.agent_x25519_pubkey. Control
  // persists this into the node's SvidRecord (svids keyspace) via
  // UpsertSvidVersion so SecretService.fetch_secret resolves the sealing
  // target identically across insecure and secure flows.
  bytes agent_x25519_pubkey = 6;
}
</file>

<file path="proto/state.proto">
syntax = "proto3";
package fleetos;

// Pushes Service Authorization Graph (SAG) updates to nodes.
service PolicyService {
  rpc WatchSag(WatchRequest) returns (stream SagUpdate);
}

// Pushes workload schedules to agents.
service SchedulerService {
  rpc WatchSchedule(WatchRequest) returns (stream ScheduleUpdate);
}

// Pushes routing tables to routers.
service RouterAssignmentService {
  rpc WatchRoutes(WatchRequest) returns (stream RouteUpdate);
}

// Broadcasts lightweight rotation notifications to agents.
service WatchService {
  rpc WatchEvents(WatchRequest) returns (stream WatchEvent);
}

// CR-4 (G-10): agents push workload liveness/readiness so control's pod
// controller has a death signal other than missing placements.
service WorkloadStatusService {
  rpc ReportWorkloadStatus(WorkloadStatusReport) returns (StatusAck);
}

message WatchRequest {
  uint64 last_known_version = 1;
}

message SagUpdate {
  uint64 version = 1;
  repeated SagRule rules = 2;
  repeated bytes revoked_delegation_ids = 3;
  // CR-5: currently-revoked SVIDs (NOT historical). Peers MUST reject peer
  // certificates whose SPIFFE URI SAN appears in this set during mTLS.
  // Control prunes entries once past the revoked SVID's TTL so the set
  // stays bounded.
  repeated string revoked_spiffe_ids = 4;
}

message SagRule {
  string id = 1;
  PeerSelector from = 2;
  PeerSelector to = 3;
  enum Action {
    ALLOW = 0;
    DENY = 1;
  }
  Action action = 4;
}

message PeerSelector {
  string tenant = 1;
  string service_name = 2;
  string role = 3;
  optional uint32 port = 4;
}

message ScheduleUpdate {
  uint64 version = 1;
  repeated WorkloadAssignment assignments = 2;
}

message WorkloadAssignment {
  string workload_id = 1;
  string runtime = 2;
  string image = 3;
  string role = 4;
}

message RouteUpdate {
  uint64 version = 1;
  repeated RouteEntry routes = 2;
}

message RouteEntry {
  string destination_svid = 1;
  string destination_role = 2;
  string target_agent_svid = 3;
  // CR-3: allocated dummy service address in canonical IPv4 value form
  // (240.0.0.45 -> 0xF000002D). 0 = none. Canonical on-wire bytes for eBPF
  // map keys are big-endian (network order): to_be_bytes() of this value;
  // consumers convert via HostOrderIpv4::from_network() at map-insertion time.
  uint32 dummy_ip = 4;
}

message WatchEvent {
  oneof event {
    SecretRotationNotification secret_rotation = 1;
    // CR-13 / V-4c: broadcast after each Raft-replicated UpsertSvidVersion
    // commit so agents learn a workload's SVID was reissued and can refetch
    // secrets sealed for the new version. Silent drops are an audit blocker.
    SvidRotationNotification svid_rotation = 2;
  }
}

message SecretRotationNotification {
  string spiffe_id = 1;
}

// CR-13 / V-4c: notification that a workload SVID was reissued
// (leader-only issuance, version replicated through Raft).
message SvidRotationNotification {
  // Canonical SPIFFE URI string — same format as
  // SecretRotationNotification.spiffe_id.
  string spiffe_id = 1;
  // The new SVID version after the rotation. Monotonically increasing per
  // spiffe_id (MonotonicVersion semantics). Agents compare against
  // FetchSecretRequest.sealed_for_svid_version to decide whether secrets
  // sealed for a prior version need refetching.
  uint64 svid_version = 2;
}

message WorkloadStatusReport {
  string pod_id = 1;      // scheduler-assigned, unique post-expansion
  string workload_id = 2;
  string tenant_id = 3;
  bool ready = 4;         // readiness probe passing
  bool live = 5;          // liveness probe passing
  uint64 observed_at_unix = 6;
}

message StatusAck {
  bool accepted = 1;
}
