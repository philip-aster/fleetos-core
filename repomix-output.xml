message ReplaceStrategy {
  uint32 max_unavailable = 1;
}

message RollingReplaceStrategy {
  uint32 max_surge = 1;
  uint32 max_unavailable = 2;
}

message PodSpec {
  string runtime = 1; // "containerd" or "cloud-hypervisor"
  repeated ContainerPort ports = 2;
  ResourceRequirements resources = 3;
  RestartPolicy restart_policy = 4;
  TerminationSpec termination = 5;
  repeated VolumeMount volumes = 6;
  repeated EnvVar env = 7;
