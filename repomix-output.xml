    fn activation_proof_rejects_wrong_secret_or_nonce() {
        let secret = [7u8; 32];
        let nonce = b"server-nonce-bytes";
        let proof = compute_activation_proof(&secret, nonce);
        assert!(!verify_activation_proof(&[8u8; 32], nonce, &proof));
