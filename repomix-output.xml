  string pool_id = 1;
  NodeKind node_kind = 2;
  uint32 desired_count = 3;
  ResourceSpec resources = 4;
  string region_hint = 5;
  bytes bootstrap_payload = 6; // opaque to the provider — Join Token + node-kind config
}

